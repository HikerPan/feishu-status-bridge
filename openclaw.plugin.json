{
  "id": "feishu-status-bridge",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "minUpdateIntervalMs": {
        "type": "integer",
        "minimum": 250,
        "default": 1500
      },
      "maxHistoryItems": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Maximum number of recent history rows to keep. Use 0 to keep all rows for the current run."
      },
      "includeToolNames": {
        "type": "boolean",
        "default": true
      },
      "showStats": {
        "type": "boolean",
        "default": true,
        "description": "Show compact model/tool/failure/update counters in the status card."
      },
      "showActiveTools": {
        "type": "boolean",
        "default": true,
        "description": "Show currently running tool calls while they are active."
      }
    }
  }
}
